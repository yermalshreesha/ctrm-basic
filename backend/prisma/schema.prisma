generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommodityCategory {
  GRAIN
  COFFEE
  SUGAR
}

enum Unit {
  MT
}

model Commodity {
  id                 String               @id @default(uuid())
  name               String               @unique
  category           CommodityCategory
  unit               Unit
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  trades             Trade[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
}

enum CounterpartyType {
  BUYER
  SELLER
  BOTH
}

model Counterparty {
  id        String           @id @default(uuid())
  name      String           @unique
  type      CounterpartyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  trades    Trade[]
}

model Warehouse {
  id                 String               @id @default(uuid())
  name               String               @unique
  location           String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  shipments          Shipment[]
}

enum TradeDirection {
  BUY
  SELL
}

enum Currency {
  USD
  EUR
  GBP
}

enum TradeStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// quantityMt > 0, price > 0 and deliveryPeriodEnd >= deliveryPeriodStart
// (BR-5, BR-6) are enforced by DB CHECK constraints added by hand in the
// 20260924150000_add_trade_check_constraints migration — Prisma's schema
// language has no CHECK-constraint attribute, so they aren't represented
// here, but `prisma migrate dev` must never be run in a way that would
// drop them (use --create-only, as that migration's own history shows).
model Trade {
  id                  String         @id @default(uuid())
  commodityId         String
  commodity           Commodity      @relation(fields: [commodityId], references: [id])
  direction           TradeDirection
  counterpartyId      String
  counterparty        Counterparty   @relation(fields: [counterpartyId], references: [id])
  quantityMt          Decimal        @db.Decimal(12, 3)
  price               Decimal        @db.Decimal(12, 2)
  currency            Currency
  deliveryPeriodStart DateTime       @db.Date
  deliveryPeriodEnd   DateTime       @db.Date
  status              TradeStatus    @default(DRAFT)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  shipments           Shipment[]

  @@index([status])
  @@index([commodityId])
  @@index([direction])
}

enum TransportMode {
  TRUCK
  RAIL
  VESSEL
}

enum ShipmentStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
}

// quantityMt > 0 and plannedArrivalDate >= plannedDepartureDate (BR-5/BR-6)
// are enforced by a DB CHECK constraint added by hand in the
// add_shipment_check_constraints migration, same pattern as Trade's
// constraints — Prisma's schema language has no CHECK-constraint
// attribute. actualArrivalDate >= actualDepartureDate (checked only once
// both are set) gets the same backstop treatment.
//
// No commodityId column (BR-8): a shipment's commodity is always read
// from shipment.trade.commodityId, never stored independently, so it can
// never disagree with its trade's commodity.
model Shipment {
  id                   String              @id @default(uuid())
  tradeId              String
  trade                Trade               @relation(fields: [tradeId], references: [id])
  warehouseId          String
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id])
  quantityMt           Decimal             @db.Decimal(12, 3)
  transportMode        TransportMode
  origin               String
  destination          String
  plannedDepartureDate DateTime            @db.Date
  plannedArrivalDate   DateTime            @db.Date
  actualDepartureDate  DateTime?           @db.Date
  actualArrivalDate    DateTime?           @db.Date
  status               ShipmentStatus      @default(PLANNED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  inventoryMovement    InventoryMovement?

  @@index([status])
  @@index([tradeId])
  @@index([warehouseId])
}

// shipmentId is @unique because a shipment triggers at most one stock
// change (its BUY delivery or its SELL departure, never both) — see
// spec.md §4. Its FOREIGN KEY constraint and @relation were added in
// Phase 3b's migration, once Shipment exists — deferred from Phase 3a,
// which only had a plain UUID column here.
//
// No updatedAt: an append-only ledger, no row is ever updated after it's
// written (ctrm-standards #2 exception).
model InventoryMovement {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  shipmentId  String    @unique
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
  quantityMt  Decimal   @db.Decimal(12, 3)
  createdAt   DateTime  @default(now())

  @@index([warehouseId, commodityId])
}

// Derived/materialized balance, one row per warehouse+commodity,
// recomputed inside the same transaction that writes an InventoryMovement
// (backend/src/modules/inventory/service.ts). CHECK (quantityMt >= 0) is
// added by hand in a follow-up migration, same pattern as Trade's
// constraints — Prisma's schema language has no CHECK-constraint
// attribute.
//
// Composite primary key instead of a separate id, and no createdAt: this
// row has no identity independent of the warehouse+commodity it's derived
// from (ctrm-standards #2 exception).
model InventoryBalance {
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  quantityMt  Decimal   @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@id([warehouseId, commodityId])
}
