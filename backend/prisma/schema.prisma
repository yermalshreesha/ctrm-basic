generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommodityCategory {
  GRAIN
  COFFEE
  SUGAR
}

enum Unit {
  MT
}

model Commodity {
  id                 String               @id @default(uuid())
  name               String               @unique
  category           CommodityCategory
  unit               Unit
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  trades             Trade[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
}

enum CounterpartyType {
  BUYER
  SELLER
  BOTH
}

model Counterparty {
  id        String           @id @default(uuid())
  name      String           @unique
  type      CounterpartyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  trades    Trade[]
}

model Warehouse {
  id                 String               @id @default(uuid())
  name               String               @unique
  location           String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
}

enum TradeDirection {
  BUY
  SELL
}

enum Currency {
  USD
  EUR
  GBP
}

enum TradeStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// quantityMt > 0, price > 0 and deliveryPeriodEnd >= deliveryPeriodStart
// (BR-5, BR-6) are enforced by DB CHECK constraints added by hand in the
// 20260924150000_add_trade_check_constraints migration — Prisma's schema
// language has no CHECK-constraint attribute, so they aren't represented
// here, but `prisma migrate dev` must never be run in a way that would
// drop them (use --create-only, as that migration's own history shows).
model Trade {
  id                  String         @id @default(uuid())
  commodityId         String
  commodity           Commodity      @relation(fields: [commodityId], references: [id])
  direction           TradeDirection
  counterpartyId      String
  counterparty        Counterparty   @relation(fields: [counterpartyId], references: [id])
  quantityMt          Decimal        @db.Decimal(12, 3)
  price               Decimal        @db.Decimal(12, 2)
  currency            Currency
  deliveryPeriodStart DateTime       @db.Date
  deliveryPeriodEnd   DateTime       @db.Date
  status              TradeStatus    @default(DRAFT)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([commodityId])
  @@index([direction])
}

// shipmentId is a plain UUID column, not yet a Prisma relation: the
// Shipment model doesn't exist until Phase 3b. Phase 3b's migration adds
// the FOREIGN KEY constraint and the @relation once Shipment exists —
// same "constraint added in a later migration" pattern as
// 20260924150000_add_trade_check_constraints. It's @unique because a
// shipment triggers at most one stock change (its BUY delivery or its
// SELL departure, never both) — see spec.md §4.
//
// No updatedAt: an append-only ledger, no row is ever updated after it's
// written (ctrm-standards #2 exception).
model InventoryMovement {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  shipmentId  String    @unique
  quantityMt  Decimal   @db.Decimal(12, 3)
  createdAt   DateTime  @default(now())

  @@index([warehouseId, commodityId])
}

// Derived/materialized balance, one row per warehouse+commodity,
// recomputed inside the same transaction that writes an InventoryMovement
// (backend/src/modules/inventory/service.ts). CHECK (quantityMt >= 0) is
// added by hand in a follow-up migration, same pattern as Trade's
// constraints — Prisma's schema language has no CHECK-constraint
// attribute.
//
// Composite primary key instead of a separate id, and no createdAt: this
// row has no identity independent of the warehouse+commodity it's derived
// from (ctrm-standards #2 exception).
model InventoryBalance {
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  quantityMt  Decimal   @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@id([warehouseId, commodityId])
}
